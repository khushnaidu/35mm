{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/l/:id", "destination": "/open/index.html" },
    { "source": "/person/:id", "destination": "/open/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
